{% extends 'base.html.twig' %}
{% import 'public/landing/_advisor.html.twig' as people %}

{% block title %}Carrousel LinkedIn{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block theme %}
<style>
    @page { size: 1080px 1350px; margin: 0; }
    html, body { margin: 0; padding: 0; background: #e6f5f1; }
    .slide { position: relative; box-sizing: border-box; display: flex; flex-direction: column; width: 1080px; height: 1350px; padding: 72px; overflow: hidden; background: #e6f5f1; color: #0f4c5c; page-break-after: always; break-after: page; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .slide--light { background: #fff; }
    .slide--end { background: #ffc845; color: #0a3540; }
    .slide__brand { display: flex; align-items: center; gap: 16px; font-size: 30px; font-weight: 700; }
    .slide__brand img { width: 56px; height: 56px; }
    .slide__step { position: absolute; top: 80px; right: 72px; color: #4b6b75; font-size: 28px; font-weight: 600; }
    .slide h1, .slide h2 { margin: 0; color: inherit; letter-spacing: -.03em; }
    .slide h2 { margin-top: 56px; font-size: 76px; line-height: 1.04; }
    .slide p { margin: 24px 0 0; font-size: 36px; line-height: 1.32; color: #2f5a66; }
    .slide--end p { color: #0a3540; }
    /* L'écran est large et son tiers droit est vide : on recadre pour agrandir ce qui compte. */
    .slide__shot { flex: none; margin-block: auto; overflow: hidden; border-radius: 26px; box-shadow: 0 0 0 2px #c9e2dc, 0 30px 60px -24px rgb(15 53 66 / .45); }
    .slide__shot img { display: block; width: 1120px; max-width: none; }
        .slide__shot--page { flex: 1; margin-block: 48px -72px; min-height: 0; border-radius: 26px 26px 0 0; }
    .slide__shot--page img { width: 100%; }
    .slide__phone { align-self: center; flex: 1; min-height: 0; width: 470px; margin-top: 44px; margin-bottom: -72px; overflow: hidden; border: 12px solid #0f4c5c; border-bottom: 0; border-radius: 52px 52px 0 0; }
    .slide__phone img { display: block; width: 100%; }
    .slide__cover { flex: 1; display: flex; flex-direction: column; justify-content: center; }
    .slide__cover h1 { font-size: 108px; line-height: 1.02; }
    .slide__cover p { font-size: 40px; }
    .slide__led { width: fit-content; margin-bottom: 48px; padding: 24px 38px; border-radius: 20px; background: #0f1b26; color: #ffb238; }
    .slide__led .display__digits { font-size: 150px; }
    .slide__team { display: flex; margin-top: 48px; }
    .slide__team span { width: 150px; height: 150px; margin-right: -24px; overflow: hidden; border-radius: 50%; box-shadow: 0 0 0 8px #fff; }
    .slide__for { margin-top: 36px !important; font-weight: 700; }
    .slide__url { align-self: flex-start; margin-top: 44px; padding: 26px 46px; border-radius: 999px; background: #0f4c5c; color: #fff; font-size: 50px; font-weight: 700; letter-spacing: -.01em; }
    .slide__who { margin-top: auto !important; font-size: 32px !important; }
</style>
{% endblock %}

{% block page %}
    {% for number in numbers %}
        {% if number == 1 %}
            <section class="slide">
                <div class="slide__brand"><img src="/logo.svg" alt="">Ma Relation Clients</div>
                <div class="slide__cover">
                    <div class="slide__led"><span class="display__digits" data-ghost="88">04</span></div>
                    <h1>Vous êtes sur le chantier. Vos clients vous écrivent.</h1>
                    <p>Remplacez le répondeur que vous n'avez pas le temps d'écouter.</p>
                    <div class="slide__team">
                        <span>{{ people.advisor('#f2c9a8', '#3b2a20', '#0f6e6e', '#bfe8df', true) }}</span>
                        <span>{{ people.advisor('#8d5a3c', '#1d1612', '#f5b82e', '#fdeab5') }}</span>
                        <span>{{ people.advisor('#e8b48f', '#a9592d', '#2b4c9b', '#d6dcfb', true) }}</span>
                    </div>
                </div>
            </section>
        {% elseif number == 2 %}
            <section class="slide slide--light">
                <div class="slide__brand"><img src="/logo.svg" alt="">Ma Relation Clients</div>
                <span class="slide__step">2 / 7</span>
                <h2>Vos clients écrivent comme ils veulent.</h2>
                <p>Sur WhatsApp, ou par un formulaire s'ils ne l'ont pas. À vos couleurs.</p>
                <div class="slide__shot slide__shot--page"><img src="/marketing/contact.png" alt=""></div>
            </section>
        {% elseif number == 3 %}
            <section class="slide slide--light">
                <div class="slide__brand"><img src="/logo.svg" alt="">Ma Relation Clients</div>
                <span class="slide__step">3 / 7</span>
                <h2>Tout arrive sur un seul dashboard.</h2>
                <p>Vous ne passez plus à côté d'une demande. Le compteur vous dit ce qu'il reste à traiter.</p>
                <div class="slide__shot"><img src="/marketing/inbox.jpg" alt=""></div>
            </section>
        {% elseif number == 4 %}
            <section class="slide slide--light">
                <div class="slide__brand"><img src="/logo.svg" alt="">Ma Relation Clients</div>
                <span class="slide__step">4 / 7</span>
                <h2>Les messages vocaux se lisent.</h2>
                <p>Ils arrivent transcrits, et le client voit ce que vous avez compris.</p>
                <div class="slide__shot"><img src="/marketing/vocal.jpg" alt=""></div>
            </section>
        {% elseif number == 5 %}
            <section class="slide slide--light">
                <div class="slide__brand"><img src="/logo.svg" alt="">Ma Relation Clients</div>
                <span class="slide__step">5 / 7</span>
                <h2>Le soir, vous traitez tout au même endroit.</h2>
                <p>Votre réponse repart par WhatsApp ou par courriel, selon le client.</p>
                <div class="slide__shot"><img src="/marketing/conversation.jpg" alt=""></div>
            </section>
        {% elseif number == 6 %}
            <section class="slide slide--light">
                <div class="slide__brand"><img src="/logo.svg" alt="">Ma Relation Clients</div>
                <span class="slide__step">6 / 7</span>
                <h2>Pas de WhatsApp ? Un lien privé.</h2>
                <p>Le client suit l'échange sans créer de compte.</p>
                <div class="slide__phone"><img src="/marketing/suivi.png" alt=""></div>
            </section>
        {% else %}
            <section class="slide slide--end">
                <div class="slide__brand"><img src="/logo.svg" alt="">Ma Relation Clients</div>
                <div class="slide__cover">
                    <h1>Vos clients ne restent plus sans réponse.</h1>
                    <p class="slide__for">Idéal pour les artisans, les auto-entrepreneurs et les PME.</p>
                    <div class="slide__url">ma-relation-clients.fr</div>
                </div>
                <p class="slide__who">Alexis Lepoutre, IT-Room. Hébergé en France.</p>
            </section>
        {% endif %}
    {% endfor %}
{% endblock %}
