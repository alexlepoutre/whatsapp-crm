<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Ma Relation Clients{% endblock %}{% block title_suffix %}{% endblock %}</title>
    {# Une description fait d'une page une page publique : balises de référencement et de partage. #}
    {% set description %}{% block description %}{% endblock %}{% endset %}
    {% if description|trim %}{{ include('_seo.html.twig', {title: block('title'), description: description|trim}) }}{% endif %}
    {% block robots %}{% endblock %}
    {% block favicon %}
        {# Le numéro de version force les navigateurs, qui gardent longtemps une favicon, à la renouveler. #}
        <link rel="icon" href="{{ asset('favicon.ico') }}?v=2" sizes="32x32">
        <link rel="icon" href="{{ asset('favicon.svg') }}?v=2" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}?v=2">
    {% endblock %}
    <link rel="stylesheet" href="{{ asset('css/app.css') }}?v={{ assets_version }}">
    {% block theme %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {% block page %}{% endblock %}
</body>
</html>
