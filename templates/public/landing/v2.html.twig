{% extends 'public/landing/layout.html.twig' %}

{% block title %}Relation clients : toutes vos demandes, un seul flux{% endblock %}
{% block body_class %}lv2{% endblock %}

{% block landing %}
    <main>
        <section class="v2-head">
            <h1>Toutes vos demandes clients, un seul flux.</h1>
            <p>Remplacez le répondeur que vous n'avez pas le temps d'écouter. Vos clients écrivent là où ils veulent, vos conseillers répondent là où ils sont.</p>
            <div class="l-actions">
                {% if waUrl %}
                    <a class="l-btn l-btn--wa" href="{{ waUrl }}">{{ include('_whatsapp_logo.html.twig') }} Essayer sur WhatsApp</a>
                {% endif %}
                <a class="l-btn l-btn--ghost" href="{{ path('contact', {slug: 'itroom'}) }}">Essayer le formulaire</a>
            </div>
        </section>

        {{ include('public/landing/_flow.html.twig') }}

        <p class="v2-return">La réponse repart toute seule par le canal du client : sur WhatsApp, ou par courriel avec son lien privé.</p>

        {{ include('public/landing/_field.html.twig') }}

        <section class="v2-steps">
            <h2>Tout au long de l'échange</h2>
            <ul>
                <li><h3>Réponse automatique</h3><p>Votre client sait tout de suite que son message est arrivé.</p></li>
                <li><h3>Vocaux transcrits</h3><p>Lisez en quelques secondes ce qu'il aurait fallu écouter.</p></li>
                <li><h3>Coches bleues</h3><p>Le client voit quand un conseiller a ouvert sa demande.</p></li>
                <li><h3>Clôture simple</h3><p>Sur votre dernière réponse, il choisit de clôturer ou de continuer.</p></li>
            </ul>
        </section>

        <section class="v2-end">
            <h2>Voyez le flux en vrai</h2>
            <a class="l-btn l-btn--action" href="{{ path('contact', {slug: 'itroom'}) }}">Envoyer une demande d'essai</a>
        </section>
    </main>
{% endblock %}
