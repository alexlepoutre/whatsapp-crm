{% extends 'public/landing/layout.html.twig' %}
{% import 'public/landing/_advisor.html.twig' as people %}

{% block title %}Relation clients : toutes vos demandes, un seul flux{% endblock %}
{% block body_class %}lv2{% endblock %}

{% block landing %}
    <main>
        <section class="v2-head">
            <h1>Toutes vos demandes clients, un seul flux.</h1>
            <p>Remplacez le répondeur que vous n'avez pas le temps d'écouter. Vos clients écrivent là où ils veulent, vos conseillers répondent là où ils sont.</p>
            <div class="l-actions">
                {% if waUrl %}
                    <a class="l-btn l-btn--wa" href="{{ waUrl }}">{{ include('_whatsapp_logo.html.twig') }} Essayer sur WhatsApp</a>
                {% endif %}
                <a class="l-btn l-btn--ghost" href="{{ path('contact', {slug: 'itroom'}) }}">Essayer le formulaire</a>
            </div>
        </section>

        <section class="v2-flow" aria-label="Le client écrit, la demande arrive sur le dashboard, un conseiller répond">
            <div class="v2-col">
                <h2>Le client écrit</h2>
                <figure class="v2-node">
                    <svg viewBox="0 0 96 96" aria-hidden="true">
                        <rect x="28" y="6" width="40" height="84" rx="8" class="p-line"/>
                        <rect x="35" y="22" width="26" height="14" rx="5" class="p-wa"/>
                        <rect x="35" y="42" width="20" height="10" rx="4" class="p-soft"/>
                        <circle cx="48" cy="80" r="3" class="p-fill"/>
                    </svg>
                    <figcaption><strong>WhatsApp</strong> Un message ou un vocal, depuis son téléphone</figcaption>
                </figure>
                <figure class="v2-node">
                    <svg viewBox="0 0 96 96" aria-hidden="true">
                        <rect x="12" y="18" width="72" height="50" rx="6" class="p-line"/>
                        <path d="M4 78h88" class="p-stroke"/>
                        <rect x="22" y="28" width="52" height="7" rx="3" class="p-soft"/>
                        <rect x="22" y="40" width="52" height="7" rx="3" class="p-soft"/>
                        <rect x="22" y="52" width="24" height="8" rx="3" class="p-action"/>
                    </svg>
                    <figcaption><strong>Formulaire</strong> Sur votre site, avec un lien privé pour suivre l'échange</figcaption>
                </figure>
            </div>

            <div class="v2-link" aria-hidden="true"></div>

            <div class="v2-hub">
                <h2>Tout arrive sur votre dashboard</h2>
                <div class="v2-screen" aria-hidden="true">
                    <div class="v2-led"><span class="display__digits" data-ghost="88">03</span><span class="display__label">à traiter</span></div>
                    <p><i class="v2-dot v2-dot--wa"></i> Camille <span>Où en est ma commande ?</span></p>
                    <p><i class="v2-dot v2-dot--form"></i> Dominique <span>Demande de devis</span></p>
                    <p><i class="v2-dot v2-dot--wa"></i> Sacha <span>Vocal transcrit</span></p>
                </div>
                <p class="v2-note">Classé par client, avec une alerte par courriel à chaque message.</p>
            </div>

            <div class="v2-link" aria-hidden="true"></div>

            <div class="v2-col">
                <h2>Le conseiller répond</h2>
                <figure class="v2-node">
                    <span class="v2-person">{{ people.advisor('#f2c9a8', '#3b2a20', '#2346d5', '#dfe5fb', true) }}</span>
                    <svg viewBox="0 0 96 96" aria-hidden="true">
                        <rect x="10" y="14" width="76" height="52" rx="5" class="p-line"/>
                        <path d="M38 66l-4 16h28l-4-16M28 82h40" class="p-stroke"/>
                        <rect x="20" y="26" width="34" height="8" rx="3" class="p-soft"/>
                        <rect x="42" y="42" width="34" height="10" rx="4" class="p-action"/>
                    </svg>
                    <figcaption><strong>Sur ordinateur</strong> Au bureau, depuis un navigateur</figcaption>
                </figure>
                <figure class="v2-node">
                    <span class="v2-person">{{ people.advisor('#8d5a3c', '#1d1612', '#0b7a5b', '#dcefe8') }}</span>
                    <svg viewBox="0 0 96 96" aria-hidden="true">
                        <rect x="28" y="6" width="40" height="84" rx="8" class="p-line"/>
                        <rect x="35" y="22" width="20" height="10" rx="4" class="p-soft"/>
                        <rect x="41" y="40" width="20" height="14" rx="5" class="p-action"/>
                        <circle cx="48" cy="80" r="3" class="p-fill"/>
                    </svg>
                    <figcaption><strong>Sur smartphone</strong> En déplacement, sans rien installer</figcaption>
                </figure>
            </div>
        </section>

        <p class="v2-return">La réponse repart toute seule par le canal du client : sur WhatsApp, ou par courriel avec son lien privé.</p>

        <section class="v2-steps">
            <h2>Tout au long de l'échange</h2>
            <ul>
                <li><h3>Réponse automatique</h3><p>Votre client sait tout de suite que son message est arrivé.</p></li>
                <li><h3>Vocaux transcrits</h3><p>Lisez en quelques secondes ce qu'il aurait fallu écouter.</p></li>
                <li><h3>Coches bleues</h3><p>Le client voit quand un conseiller a ouvert sa demande.</p></li>
                <li><h3>Clôture simple</h3><p>Sur votre dernière réponse, il choisit de clôturer ou de continuer.</p></li>
            </ul>
        </section>

        <section class="v2-end">
            <h2>Voyez le flux en vrai</h2>
            <a class="l-btn l-btn--action" href="{{ path('contact', {slug: 'itroom'}) }}">Envoyer une demande d'essai</a>
        </section>
    </main>
{% endblock %}
