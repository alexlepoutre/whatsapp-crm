{% extends 'base.html.twig' %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}
{% block theme %}<link rel="stylesheet" href="{{ asset('css/landing.css') }}">{% endblock %}

{% block page %}
    {% set waUrl = editor and whatsappNumber ? 'https://wa.me/' ~ whatsappNumber ~ '?text=' ~ editor.whatsAppOpening|url_encode : null %}

    <header class="l-top">
        <a class="l-brand" href="{{ path('home') }}">
            <img src="{{ asset('logo.svg') }}" alt="" width="36" height="36">
            Relation clients
        </a>
        <a class="l-login" href="{{ path('login') }}">Se connecter</a>
    </header>

    {% block landing %}{% endblock %}

    {{ include('_footer.html.twig') }}

    <nav class="l-switch" aria-label="Comparer les propositions">
        <a href="{{ path('home') }}">Actuelle</a>
        {% for item in ['v1', 'v2', 'v3'] %}
            <a href="{{ path('landing', {version: item}) }}" {% if item == version %}aria-current="page"{% endif %}>{{ item|upper }}</a>
        {% endfor %}
    </nav>
{% endblock %}
