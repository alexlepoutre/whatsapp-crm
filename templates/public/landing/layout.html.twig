{% extends 'base.html.twig' %}

{% block robots %}{% if version %}<meta name="robots" content="noindex, nofollow">{% endif %}{% endblock %}
{% block theme %}<link rel="stylesheet" href="{{ asset('css/landing.css') }}?v={{ assets_version }}">{% endblock %}

{% block page %}
    {% set waUrl = editor and whatsappNumber ? 'https://wa.me/' ~ whatsappNumber ~ '?text=' ~ editor.whatsAppOpening|url_encode : null %}

    <header class="l-top">
        <a class="l-brand" href="{{ path('home') }}">
            <img src="{{ asset('logo.svg') }}" alt="" width="36" height="36">
            <span class="brand-text">Ma Relation Clients<small class="l-for">Idéal pour les artisans, les auto-entrepreneurs et les PME</small></span>
        </a>
        <a class="l-login" href="{{ path('login') }}">Se connecter</a>
    </header>

    {% block landing %}{% endblock %}

    {{ include('_footer.html.twig') }}
    {{ include('_consent.html.twig') }}

    {% if waUrl %}
        <a class="l-float" href="{{ waUrl }}" aria-label="Écrire sur WhatsApp">{{ include('_whatsapp_logo.html.twig') }}</a>
    {% endif %}

    {% if version %}
        <nav class="l-switch" aria-label="Comparer les propositions">
            <a href="{{ path('home') }}">Accueil</a>
            {% for item in ['v2', 'v3'] %}
                <a href="{{ path('landing', {version: item}) }}" {% if item == version %}aria-current="page"{% endif %}>{{ item|upper }}</a>
            {% endfor %}
        </nav>
    {% endif %}
{% endblock %}
