{% extends 'base.html.twig' %}

{% block title %}Contacter {{ organization.name }}{% endblock %}
{% block body_class %}public{% endblock %}
{% block theme %}{{ include('_theme.html.twig', {theme: organization}) }}{% endblock %}

{% block page %}
    <main class="public__main">
        {{ include('public/_header.html.twig') }}
        <h1 class="public__title">Laissez-nous un message, nous vous répondons.</h1>
        {{ include('_flashes.html.twig') }}

        {% if whatsappNumber %}
            <p class="lead">Le plus rapide est de nous écrire sur WhatsApp. Votre premier message est déjà prêt : <strong>envoyez-le d'abord tel quel</strong>, puis posez votre question dans le message suivant.</p>
            <a class="btn btn--whatsapp" href="https://wa.me/{{ whatsappNumber }}?text={{ organization.whatsAppOpening|url_encode }}">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.2-.3-.2-.6-.4zM12 2a10 10 0 0 0-8.6 15l-1.3 4.9 5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
                Écrire sur WhatsApp
            </a>
            <h2>Vous n'avez pas WhatsApp ?</h2>
        {% endif %}

        <p class="lead">Remplissez ce formulaire. Vous recevrez par e-mail un lien privé pour suivre notre échange, sans créer de compte.</p>

        {{ form_start(form) }}
            {{ form_widget(form) }}
            <p class="muted">Vos coordonnées servent uniquement à répondre à votre demande.</p>
            <button type="submit" class="btn">Envoyer ma demande</button>
        {{ form_end(form) }}
    </main>
{% endblock %}
