{% extends 'base.html.twig' %}

{% block title %}Connexion : Ma Relation Clients{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}
{% block body_class %}home{% endblock %}
{% block theme %}<link rel="stylesheet" href="{{ asset('css/landing.css') }}?v={{ assets_version }}">{% endblock %}

{% block page %}
    <div class="stage stage--signin">
        <header class="home__top">
            <a class="home__brand" href="{{ path('home') }}">
                <img src="{{ asset('logo.svg') }}" alt="" width="36" height="36">
                Ma Relation Clients
            </a>
            <a class="btn btn--on-dark" href="{{ path('home') }}">Accueil</a>
        </header>

        <main class="signin">
            <div class="signin__intro">
                <p class="signin__claim">Vos clients vous attendent.</p>
                <p class="hero__lead">Retrouvez sur votre dashboard toutes les demandes reçues, sur WhatsApp et par formulaire.</p>
            </div>

            <div class="signin__card">
                <h1>Connexion</h1>

                {% if error %}
                    <p class="flash flash--error" role="alert">
                        {{ 'Too many' in error.messageKey
                            ? 'Trop de tentatives. Réessayez dans quelques minutes.'
                            : 'E-mail ou mot de passe incorrect.' }}
                    </p>
                {% endif %}

                <form method="post">
                    <div>
                        <label for="email">E-mail</label>
                        <input id="email" type="email" name="_username" value="{{ lastEmail }}" autocomplete="email" required autofocus>
                    </div>
                    <div>
                        <label for="password">Mot de passe</label>
                        <input id="password" type="password" name="_password" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="btn signin__submit">Se connecter</button>
                </form>
            </div>
        </main>
    </div>

    {{ include('_footer.html.twig') }}
{% endblock %}
