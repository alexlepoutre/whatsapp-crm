{% extends 'base.html.twig' %}

{% block title %}Relation clients : remplacez le répondeur que vous n'avez pas le temps d'écouter{% endblock %}
{% block description %}<meta name="description" content="Vos clients vous écrivent sur WhatsApp ou par formulaire. Un dashboard centralise leurs demandes : vous n'en manquez plus aucune.">{% endblock %}
{% block body_class %}home{% endblock %}
{% block theme %}<link rel="stylesheet" href="{{ asset('css/landing.css') }}">{% endblock %}

{% block page %}
    <div class="stage">
        <header class="home__top">
            <a class="home__brand" href="{{ path('home') }}">
                <img src="{{ asset('logo.svg') }}" alt="" width="36" height="36">
                Relation clients
            </a>
            {% if app.user %}
                <a class="btn btn--on-dark" href="{{ path('admin_inbox') }}">Ouvrir mes messages</a>
            {% else %}
                <a class="btn btn--on-dark" href="{{ path('login') }}">Se connecter</a>
            {% endif %}
        </header>

        <section class="hero">
            <div>
                <h1>Remplacez le répondeur que vous n'avez pas le temps d'écouter.</h1>
                <p class="hero__lead">Vos clients vous écrivent sur WhatsApp ou par formulaire. Vous avez un dashboard qui centralise les demandes reçues : vous ne passez plus à côté d'une demande et vous les traitez au fil du temps.</p>
                <p class="l-for">Idéal pour les artisans, les auto-entrepreneurs et les PME.</p>
                <div class="hero__actions">
                    {% if editor and whatsappNumber %}
                        <a class="btn btn--whatsapp" href="https://wa.me/{{ whatsappNumber }}?text={{ editor.whatsAppOpening|url_encode }}">
                            {{ include('_whatsapp_logo.html.twig') }}
                            Écrire sur WhatsApp
                        </a>
                    {% endif %}
                    <a class="btn btn--on-dark btn--big" href="{{ path('contact', {slug: 'itroom'}) }}">Utiliser le formulaire</a>
                </div>
            </div>

            {# Illustration : ces messages sont fictifs. #}
            <div class="device" data-device aria-hidden="true">
                <span class="wa-tile wa-tile--float">{{ include('_whatsapp_logo.html.twig') }}</span>
                <div class="device__display">
                    <span class="display__digits" data-ghost="88" data-counter>03</span>
                    <span class="display__label">à traiter</span>
                </div>
                <ul class="device__list">
                    <li><strong>Camille</strong><span class="tag tag--whatsapp">{{ include('_whatsapp_logo.html.twig') }} WhatsApp</span><p>Où en est ma commande ?</p></li>
                    <li><strong>Dominique</strong><span class="tag tag--form">Formulaire</span><p>Pouvez-vous m'envoyer un devis ?</p></li>
                    <li><strong>Sacha</strong><span class="tag tag--whatsapp">{{ include('_whatsapp_logo.html.twig') }} WhatsApp</span><p>Message vocal, transcrit : êtes-vous ouverts samedi ?</p></li>
                </ul>
            </div>
        </section>
    </div>

    <main>
        {{ include('public/landing/_field.html.twig') }}

        <section class="compare">
            <div class="compare__before">
                <h2>Avec un répondeur</h2>
                <ul>
                    <li>Chaque message s'écoute du début à la fin</li>
                    <li>Une demande oubliée est une demande perdue</li>
                    <li>Votre client ne sait pas si vous l'avez entendu</li>
                </ul>
            </div>
            <div class="compare__after">
                <h2>Avec Relation clients</h2>
                <ul>
                    <li>Chaque demande se lit en quelques secondes, même un vocal</li>
                    <li>Une demande reste à traiter tant que vous n'y avez pas répondu</li>
                    <li>Votre client reçoit une réponse automatique, puis voit que vous avez lu</li>
                </ul>
            </div>
        </section>

        <section class="steps">
            <h2>Comment ça se passe</h2>
            <ol>
                <li>
                    <h3>Votre client vous écrit</h3>
                    <p>Depuis votre page de contact, il choisit WhatsApp ou le formulaire. Il n'a aucun compte à créer.</p>
                </li>
                <li>
                    <h3>Tout arrive sur votre dashboard</h3>
                    <p>Un courriel vous prévient à chaque message. Le compteur vous dit combien de demandes restent à traiter : rien ne vous échappe.</p>
                </li>
                <li>
                    <h3>Vous traitez au fil du temps</h3>
                    <p>Votre réponse part par WhatsApp ou par courriel, selon le canal choisi par le client. Il peut ensuite clôturer sa demande ou continuer.</p>
                </li>
            </ol>
        </section>

        <section class="sides">
            <div>
                <h2>Pour vos clients</h2>
                <ul>
                    <li>Un bouton qui ouvre WhatsApp, avec le premier message déjà prêt</li>
                    <li>Un formulaire pour ceux qui n'ont pas WhatsApp</li>
                    <li>Un lien privé pour suivre l'échange et répondre, sans mot de passe</li>
                    <li>Des messages vocaux acceptés : le texte compris leur est renvoyé</li>
                </ul>
            </div>
            <div>
                <h2>Pour votre équipe</h2>
                <ul>
                    <li>Un dashboard qui centralise toutes les demandes reçues</li>
                    <li>Une fiche par client, avec tous ses échanges et vos notes</li>
                    <li>Des comptes pour chaque personne qui répond</li>
                    <li>Les vocaux à lire plutôt qu'à écouter, grâce à la transcription</li>
                    <li>Votre logo, vos couleurs et votre adresse d'envoi</li>
                </ul>
            </div>
        </section>

        <section class="closing">
            <div>
                <h2>Une question sur l'outil ?</h2>
                <p>Posez-la : c'est le meilleur moyen de l'essayer.</p>
            </div>
            <a class="btn btn--amber" href="{{ path('contact', {slug: 'itroom'}) }}">Nous poser une question</a>
        </section>
    </main>

    {{ include('_footer.html.twig') }}

    <script>
        // Un seul moment animé : le compteur monte pendant que les messages arrivent.
        (() => {
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
                return;
            }

            const device = document.querySelector('[data-device]');
            const counter = device.querySelector('[data-counter]');
            const rows = [...device.querySelectorAll('li')];

            device.classList.add('is-playing');
            counter.textContent = '00';

            rows.forEach((row, index) => {
                setTimeout(() => {
                    row.classList.add('is-in');
                    counter.textContent = String(index + 1).padStart(2, '0');
                }, 500 + index * 650);
            });
        })();
    </script>
{% endblock %}
