{% extends 'base.html.twig' %}

{% block title %}Suivi de votre demande{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}
{% block body_class %}public{% endblock %}
{% block theme %}{{ include('_theme.html.twig', {theme: conversation.organization}) }}{% endblock %}

{% block page %}
    <main class="public__main">
        {{ include('public/_header.html.twig', {organization: conversation.organization}) }}
        <h1>{{ conversation.title }}</h1>
        <p class="muted">Demande envoyée le {{ conversation.createdAt|date('d/m/Y') }}. Ce lien est privé : ne le partagez pas.</p>
        {{ include('_flashes.html.twig') }}

        <div class="thread">
            {% for message in conversation.messages %}
                <article class="bubble {{ message.isFromClient ? 'bubble--out' : 'bubble--in' }}">
                    <p class="bubble__meta">{{ message.isFromClient ? 'Vous' : conversation.organization.name }}, le {{ message.createdAt|date('d/m/Y à H\\hi') }}</p>
                    <p>{{ message.body|nl2br }}</p>
                </article>
            {% endfor %}
        </div>

        {% set routeArguments = {slug: conversation.organization.slug, token: conversation.accessToken} %}

        {% if conversation.awaitingClosure %}
            <section class="closure-choice">
                <h2>Votre demande est-elle traitée ?</h2>
                <div class="closure-choice__actions">
                    <form method="post" action="{{ path('tracking_close', routeArguments) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('tracking-choice') }}">
                        <button type="submit" class="btn">Clôturer ma demande</button>
                    </form>
                    <form method="post" action="{{ path('tracking_continue', routeArguments) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('tracking-choice') }}">
                        <button type="submit" class="btn btn--quiet">Continuer la conversation</button>
                    </form>
                </div>
            </section>
        {% endif %}

        {% if conversation.isClosed %}
            <p class="notice">Cette demande est clôturée. Si vous écrivez un nouveau message, elle sera rouverte.</p>
        {% endif %}

        {{ form_start(form, {attr: {class: 'composer'}}) }}
            {{ form_row(form.body) }}
            <button type="submit" class="btn">Envoyer mon message</button>
        {{ form_end(form) }}

        {% if not conversation.isClosed and not conversation.awaitingClosure %}
            <form method="post" action="{{ path('tracking_close', routeArguments) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('tracking-choice') }}">
                <button type="submit" class="btn btn--quiet">Clôturer ma demande</button>
            </form>
        {% endif %}
    </main>
    {{ include('_footer.html.twig') }}
{% endblock %}
