<a class="row row--{{ conversation.channel.value }}" href="{{ path('admin_conversation', {id: conversation.id}) }}">
    <span class="row__who">{{ conversation.client.displayName }}</span>
    <span class="row__when">{{ conversation.lastMessageAt ? conversation.lastMessageAt|date('d/m à H\\hi') }}</span>
    <span class="row__what">
        {% if conversation.subject %}<strong>{{ conversation.subject }}</strong><br>{% endif %}
        {% set preview = conversation.lastClientMessage ? conversation.lastClientMessage.body : '' %}
        {{ preview|length > 120 ? preview|slice(0, 120)|trim ~ '…' : preview }}
    </span>
    <span class="row__tags">
        <span class="tag tag--{{ conversation.channel.value }}">{{ conversation.channel.label }}</span>
        <span class="tag">{{ conversation.status.label }}</span>
    </span>
</a>
