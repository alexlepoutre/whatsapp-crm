{% extends 'admin/layout.html.twig' %}

{% block title %}{{ conversation.client.displayName }}{% endblock %}

{% block body %}
    <header class="head">
        <div>
            <h1><a href="{{ path('admin_client', {id: conversation.client.id}) }}">{{ conversation.client.displayName }}</a></h1>
            <p class="muted">{{ conversation.title }}</p>
        </div>
        <div class="row__tags">
            <span class="tag tag--{{ conversation.channel.value }}">{{ conversation.channel.label }}</span>
            <span class="tag">{{ conversation.status.label }}</span>
        </div>
    </header>

    {% if conversation.accessToken %}
        {% set privateLink = url('tracking_show', {slug: conversation.organization.slug, token: conversation.accessToken}) %}
        <section class="private-link">
            <label for="private-link">Lien privé du client</label>
            <div class="private-link__row">
                <input id="private-link" type="text" value="{{ privateLink }}" readonly>
                <button type="button" class="btn btn--quiet" data-copy="#private-link">Copier</button>
                <a class="btn btn--quiet" href="{{ privateLink }}" target="_blank" rel="noopener">Ouvrir</a>
            </div>
            <p class="muted">Ce qui est écrit depuis ce lien apparaît comme un message du client : pour répondre, utilisez le formulaire de cette page.</p>
        </section>
    {% endif %}

    <div class="thread">
        {% for message in conversation.messages %}
            <article class="bubble {{ message.isFromClient ? 'bubble--in' : (message.isFromBot ? 'bubble--bot' : 'bubble--out') }}">
                <p class="bubble__meta">
                    {{ message.isFromClient ? conversation.client.displayName : (message.isFromBot ? 'Réponse automatique' : 'Vous') }},
                    le {{ message.createdAt|date('d/m/Y à H\\hi') }}
                </p>
                <p>{{ message.body|nl2br }}</p>
                {% if message.deliveryStatus %}
                    <p class="bubble__status{{ message.deliveryStatus.value == 'failed' ? ' bubble__status--failed' }}">
                        {{ message.deliveryStatus.label }}{% if message.failureReason %} : {{ message.failureReason }}{% endif %}
                    </p>
                {% endif %}
            </article>
        {% endfor %}
    </div>

    {% if conversation.awaitingClosure %}
        <p class="notice">Dernière réponse envoyée : le client peut clôturer ou continuer.</p>
    {% endif %}

    {% if conversation.isWhatsApp and not conversation.isWhatsAppWindowOpen %}
        <p class="notice">Le dernier message de ce client date de plus de 24 heures : WhatsApp n'autorise plus de réponse libre. Il faut attendre qu'il réécrive.</p>
    {% else %}
        {% if conversation.isWhatsApp and not whatsappConfigured %}
            <p class="notice">WhatsApp n'est pas encore connecté : votre réponse sera enregistrée sans partir.</p>
        {% endif %}
        {{ form_start(form, {attr: {class: 'composer'}}) }}
            {{ form_row(form.body) }}
            <div class="composer__actions">
                <button type="submit" class="btn">Envoyer la réponse</button>
                <button type="submit" name="final" value="1" class="btn btn--quiet">Dernière réponse</button>
            </div>
            <p class="muted">« Dernière réponse » envoie votre message et propose au client de clôturer ou de continuer.</p>
        {{ form_end(form) }}
    {% endif %}

    {% if not conversation.isClosed %}
        <form method="post" action="{{ path('admin_conversation_close', {id: conversation.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('close-conversation') }}">
            <button type="submit" class="btn btn--quiet">Clôturer la conversation</button>
        </form>
    {% endif %}

    <script>
        document.querySelectorAll('[data-copy]').forEach((button) => {
            button.addEventListener('click', async () => {
                const field = document.querySelector(button.dataset.copy);
                field.select();

                try {
                    await navigator.clipboard.writeText(field.value);
                    button.textContent = 'Copié';
                } catch {
                    button.textContent = 'Lien sélectionné';
                }
            });
        });
    </script>
{% endblock %}
