{% extends 'admin/layout.html.twig' %}

{% block title %}{{ edited.name }}{% endblock %}

{% block body %}
    {# « edited » et non « organization », qui désigne dans le layout l'organisation affichée. #}
    <h1>{{ edited.name }}</h1>
    <p class="muted">Page de contact : <a href="{{ path('contact', {slug: edited.slug}) }}">{{ url('contact', {slug: edited.slug}) }}</a></p>

    <div class="split">
        <section>
            <h2>Comptes</h2>
            <div class="rows">
                {% for user in accounts %}
                    <div class="row">
                        <a class="row__who" href="{{ path('admin_account', {id: user.id}) }}">{{ user.email }}</a>
                        <div class="row__actions">
                            <a class="btn btn--quiet" href="{{ path('admin_account', {id: user.id}) }}">Modifier</a>
                            <form method="post" action="{{ path('admin_account_delete', {id: user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">
                                <button type="submit" class="btn btn--quiet" aria-label="Supprimer {{ user.email }}">Supprimer</button>
                            </form>
                        </div>
                    </div>
                {% else %}
                    <p class="empty">Aucun compte. Ajoutez-en un pour que cette organisation traite ses messages.</p>
                {% endfor %}
            </div>

            <h2>Ajouter un compte</h2>
            {{ form_start(account) }}
                {{ form_widget(account) }}
                <button type="submit" class="btn">Créer le compte</button>
            {{ form_end(account) }}
        </section>

        <section>
            <h2>Informations</h2>
            {% if edited.logoVersion %}
                <img class="logo-preview" src="{{ path('organization_logo', {slug: edited.slug, v: edited.logoVersion}) }}" alt="Logo actuel de {{ edited.name }}">
            {% endif %}
            {{ form_start(edit) }}
                {{ form_widget(edit) }}
                <button type="submit" class="btn">Enregistrer l'organisation</button>
            {{ form_end(edit) }}

            <h2 id="messagerie">Messagerie OVH</h2>
            <p class="notice">
                {% if edited.hasSmtp %}
                    Les courriels de {{ edited.name }} partent de {{ edited.smtpUsername }}.
                {% else %}
                    Aucune boîte configurée : les courriels de {{ edited.name }} ne partiront pas.
                {% endif %}
            </p>
            {{ form_start(mail) }}
                {{ form_widget(mail) }}
                <button type="submit" class="btn">Enregistrer la messagerie</button>
            {{ form_end(mail) }}

            {% if edited.hasSmtp %}
                <form method="post" action="{{ path('admin_organization_test_mail', {id: edited.id}) }}" data-pending="Envoi en cours, jusqu'à 20 secondes…">
                    <input type="hidden" name="_token" value="{{ csrf_token('test-mail') }}">
                    <button type="submit" class="btn btn--quiet">Envoyer un courriel de test</button>
                </form>
            {% endif %}
            {% for message in app.flashes('mail_success') %}
                <p class="flash flash--success" role="status">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('mail_error') %}
                <p class="flash flash--error" role="alert">{{ message }}</p>
            {% endfor %}
        </section>
    </div>

    <section class="defaults">
        <h2 id="messages-par-defaut">Messages par défaut</h2>
        <p class="muted">Les textes envoyés automatiquement pour {{ edited.name }}. Le message automatique se modifie dans les <a href="{{ path('admin_settings') }}">réglages</a>.</p>

        {% for group, messages in defaultMessages %}
            <h3>{{ group }}</h3>
            <div class="defaults__list">
                {% for message in messages %}
                    <article class="default-message">
                        <h4>{{ message.title }}</h4>
                        <p class="muted">{{ message.when }}</p>
                        <p class="default-message__text">{{ message.text|nl2br }}</p>
                    </article>
                {% endfor %}
            </div>
        {% endfor %}
    </section>

    <script>
        // L'envoi peut durer plusieurs secondes : sans retour visuel, on reclique et on l'interrompt.
        document.querySelectorAll('form[data-pending]').forEach((form) => {
            form.addEventListener('submit', () => {
                const button = form.querySelector('button');
                button.disabled = true;
                button.textContent = form.dataset.pending;
            });
        });
    </script>
{% endblock %}
