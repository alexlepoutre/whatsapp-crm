{% extends 'base.html.twig' %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}
{# Le titre est visible d'emblée dans les rapports GA4 : c'est lui qui y identifie l'organisation. #}
{% block title_suffix %} | {{ current_organization().name }}{% endblock %}
{% block body_class %}admin{% endblock %}
{% block favicon %}{% if current_organization().logoVersion %}{{ include('_favicon_organization.html.twig', {theme: current_organization()}) }}{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block theme %}{{ include('_theme.html.twig', {theme: current_organization()}) }}{% endblock %}

{% block page %}
    {% set open = open_conversations() %}
    {% set organization = current_organization() %}
    <aside class="rail">
        <a class="display{{ open ? ' display--waiting' }}" href="{{ path('admin_inbox') }}" aria-label="{{ open }} conversation(s) à traiter">
            <span class="display__digits" aria-hidden="true">{{ open > 99 ? '99+' : open }}</span>
            <span class="display__label" aria-hidden="true">à traiter</span>
        </a>
        {% if is_granted('ROLE_SUPER_ADMIN') %}
            {% set counts = open_by_organization() %}
            <ul class="orgs" aria-label="Organisations et messages à traiter">
                {% for item in all_organizations() %}
                    {% set count = counts[item.id] ?? 0 %}
                    <li>
                        {% if item.id == organization.id %}
                            <span class="orgs__item rail__org" aria-current="true">
                                {{ item.name }} <span class="orgs__count{{ count ? ' orgs__count--waiting' }}">{{ count }}</span>
                            </span>
                        {% else %}
                            <form method="post" action="{{ path('admin_organization_switch', {id: item.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('switch-organization') }}">
                                <button type="submit" class="orgs__item">
                                    {{ item.name }} <span class="orgs__count{{ count ? ' orgs__count--waiting' }}">{{ count }}</span>
                                </button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="rail__org">{{ organization.name }}</p>
        {% endif %}
        <nav class="rail__nav">
            <a href="{{ path('admin_inbox') }}" {% if app.current_route == 'admin_inbox' %}aria-current="page"{% endif %}>Messages</a>
            <a href="{{ path('admin_clients') }}" {% if app.current_route == 'admin_clients' %}aria-current="page"{% endif %}>Clients</a>
            <a href="{{ path('admin_statistics') }}" {% if app.current_route starts with 'admin_statistics' %}aria-current="page"{% endif %}>Statistiques</a>
            <a href="{{ path('admin_settings') }}" {% if app.current_route == 'admin_settings' %}aria-current="page"{% endif %}>Réglages</a>
            {% if is_granted('ROLE_SUPER_ADMIN') %}
                <a href="{{ path('admin_organizations') }}" {% if app.current_route starts with 'admin_organization' %}aria-current="page"{% endif %}>Organisations</a>
            {% endif %}
        </nav>
        <button type="button" class="rail__cookies" data-consent-open hidden>Gérer les cookies</button>
        <a class="rail__logout" href="{{ path('logout') }}">Se déconnecter</a>
    </aside>
    <main class="main">
        <header class="banner">
            {% if organization.logoVersion %}
                <img class="banner__logo" src="{{ path('organization_logo', {slug: organization.slug, v: organization.logoVersion}) }}" alt="">
            {% endif %}
            <p class="banner__name">{{ organization.name }}</p>
        </header>
        {{ include('_flashes.html.twig') }}
        {% block body %}{% endblock %}
    </main>
    {# Une recherche met son texte dans l'adresse : ce peut être le nom d'un client. #}
    {% if not app.request.query.has('q') %}{{ include('_consent.html.twig') }}{% endif %}
{% endblock %}
