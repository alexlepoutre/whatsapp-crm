# Image de production : le code et les dépendances sont embarqués, rien n'est monté.
FROM php:8.4-fpm-alpine

RUN apk add --no-cache icu-libs libzip \
    && apk add --no-cache --virtual .build-deps icu-dev libzip-dev oniguruma-dev \
    && docker-php-ext-install -j$(nproc) pdo_mysql intl zip opcache \
    && apk del --no-network .build-deps

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php/php-prod.ini "$PHP_INI_DIR/conf.d/zz-app.ini"
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/app

ENV APP_ENV=prod APP_DEBUG=0

# Les dépendances d'abord : cette couche reste en cache tant que le fichier lock ne change pas.
# Sinon, chaque déploiement retélécharge tout depuis GitHub, qui finit par refuser.
COPY composer.json composer.lock symfony.lock ./
# Peu de téléchargements simultanés : au-delà, GitHub laisse les connexions expirer depuis ce serveur.
RUN COMPOSER_MAX_PARALLEL_HTTP=3 composer install --no-dev --no-scripts --no-autoloader --no-interaction --no-progress

COPY . .

# ARG et non ENV : ce secret de construction ne doit pas subsister dans l'image.
ARG APP_SECRET=build-time-placeholder

RUN composer dump-autoload --no-dev --optimize --no-interaction \
    && composer run-script --no-dev post-install-cmd --no-interaction \
    && rm /usr/bin/composer \
    && mkdir -p var/sessions/prod \
    && chown -R www-data:www-data var

# Aussi pour les commandes console : un cache écrit en root bloquerait php-fpm.
USER www-data

EXPOSE 9000
CMD ["php-fpm"]
