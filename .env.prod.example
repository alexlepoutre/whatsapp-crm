# Copié en .env.prod sur le serveur (chmod 600, jamais dans git). deploy.sh le crée au
# premier déploiement et génère les secrets internes.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
DEFAULT_URI=https://crm.v1.re7itroom.fr

DB_PASSWORD=
DB_ROOT_PASSWORD=
DATABASE_URL=mysql://app:<DB_PASSWORD>@database:3306/whatsapp_crm?serverVersion=11.4.0-MariaDB&charset=utf8mb4

# L'envoi direct depuis ce serveur est rejeté par Gmail : il faut un SMTP authentifié.
# Pas null://null : les réponses seraient marquées envoyées sans être parties. Tant que ce
# port fermé reste en place, les envois échouent et s'affichent comme tels.
MAILER_DSN=smtp://127.0.0.1:1
MAIL_FROM=Répondeur <noreply@crm.v1.re7itroom.fr>

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Partagé avec le hook d'immo.alesski.fr : il signe les messages qu'il relaie ici.
WHATSAPP_RELAY_SECRET=
WHATSAPP_PUBLIC_NUMBER=
